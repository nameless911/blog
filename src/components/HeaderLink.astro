---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Compare paths without "index.html", ".html" or a trailing slash
const normalize = (path: string) => path.replace(/(\/index)?\.html$/, '').replace(/\/$/, '');
const base = normalize(import.meta.env.BASE_URL);
const current = normalize(Astro.url.pathname);
const target = normalize(String(href));
const isActive = current === target || (target !== base && current.startsWith(target + '/'));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
