---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES, type Category, SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return (Object.entries(CATEGORIES) as [Category, string][]).map(([label, slug]) => ({
		params: { slug },
		props: { label },
	}));
}

const { label } = Astro.props;
const posts = (await getCollection('blog', (post) => post.data.category === label)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${label} | ${SITE_TITLE}`} description={`${label}の記事一覧`} />
		<style>
			main {
				width: 960px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<CategoryNav current={label} />
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
